{
  "name": "ztp-products-api",
  "version": "1.0.0",
  "private": true,
  "description": "Etapy 1.1–1.3: NestJS products CRUD with validation and transactional history",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.e2e.test.mjs",
    "test:all": "npm test",
    "test:products": "npm run build && node --test test/products.e2e.test.mjs",
    "test:history": "npm run build && node --test test/product-history.e2e.test.mjs",
    "test:required": "npm run test:history",
    "test:lifecycle": "npm run build && node --test test/lifecycle.e2e.test.mjs",
    "test:docker:build": "docker build --target test -t ztp-products-api-test .",
    "test:docker:run": "docker run --rm --network ztp_default --env DB_HOST=postgres --env NO_COLOR=1 ztp-products-api-test",
    "test:docker": "npm run test:docker:build && npm run test:docker:run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "~0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
