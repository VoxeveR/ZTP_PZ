PORT=8000
# Use 0.0.0.0 inside a container so Kubernetes can reach the server.
HOST=127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword
# Reserved for the future React development server.
CORS_ORIGIN=http://localhost:5173
# Notification delivery (MailHog SMTP and ntfy from ../docker-compose.yml).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@ztp.local
NTFY_URL=http://localhost:8088
# Background worker that sends due PENDING notifications.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=5000
